<?xml version="1.0" encoding="UTF-8"?>
<container>
    <bean id="engine" class="DI_container.BeanScope.TestClassesExamples.Simple.Ex1.Engine" scope="singleton">
        <constructor-args>
            <arg type="java.lang.String" value="new"/>
            <arg type="java.lang.Integer" value="120"/>
        </constructor-args>
    </bean>

    <bean id="car" class="DI_container.BeanScope.TestClassesExamples.Simple.Ex1.Car" scope="singleton">
        <constructor-args>
            <arg type="java.lang.String" value="XM1"/>
            <arg ref="engine"/>
        </constructor-args>
    </bean>
</container>
